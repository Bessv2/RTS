{
  "name": "roe-technology-services-site",
  "private": true,
  "description": "Roe Technology Services website and built-in visual editor. No runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "serve": "npx --yes http-server@14 -p 8080 -c-1 ."
  }
}
